<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="bg-gray-100">
    <ActionBar title="Energy Tracker" class="bg-blue-500 text-white">
        <ActionItem tap="{{ showStats }}" ios.position="right" android.position="actionBar">
            <Label text="Stats" class="text-white p-2" />
        </ActionItem>
    </ActionBar>

    <ScrollView>
        <StackLayout class="p-4">
            <Label text="How's your energy right now?" class="text-2xl font-bold text-center mb-4" />
            
            <GridLayout rows="auto, auto" columns="*, auto" class="mb-4">
                <Slider row="0" col="0" colSpan="2" value="{{ energyLevel }}" minValue="0" maxValue="100" 
                        class="slider" />
                <Label row="1" col="0" text="{{ energyCategory }}" class="text-lg" />
                <Label row="1" col="1" text="{{ energyLevel }}" class="text-lg font-bold" />
            </GridLayout>

            <TextView hint="Add notes (optional)" text="{{ notes }}" class="p-2 bg-white rounded mb-4" height="100" />

            <Button text="Save Entry" tap="{{ saveEntry }}" class="bg-blue-500 text-white p-4 rounded" />

            <Label text="Today's Energy" class="text-xl font-bold mt-8 mb-4" />
            <GridLayout height="300">
                <CartesianChart cache-mode="none">
                    <LineSeries items="{{ todayEntries }}"
                              categoryProperty="time"
                              valueProperty="level">
                        <LineSeries.valueAxis>
                            <LinearAxis minimum="0" maximum="100" />
                        </LineSeries.valueAxis>
                    </LineSeries>
                </CartesianChart>
            </GridLayout>

            <GridLayout rows="auto" columns="*, *, *" class="mt-4 bg-white p-4 rounded">
                <StackLayout col="0" class="text-center">
                    <Label text="Average" class="text-sm text-gray-600" />
                    <Label text="{{ todayAverage }}" class="text-lg font-bold" />
                </StackLayout>
                <StackLayout col="1" class="text-center">
                    <Label text="Peak" class="text-sm text-gray-600" />
                    <Label text="{{ todayPeak }}" class="text-lg font-bold" />
                </StackLayout>
                <StackLayout col="2" class="text-center">
                    <Label text="Lowest" class="text-sm text-gray-600" />
                    <Label text="{{ todayLowest }}" class="text-lg font-bold" />
                </StackLayout>
            </GridLayout>
        </StackLayout>
    </ScrollView>
</Page>